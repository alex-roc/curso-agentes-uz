# Copia este archivo a .env (cp .env.example .env) y edítalo. .env NUNCA se sube a GitHub.
#
# ── Ruta de modelo ──────────────────────────────────────────────────────
# local = Ollama en tu equipo; gemini = Gemini de Google (capa gratuita, sin tarjeta);
# openrouter = modelos :free de OpenRouter; offline = modelo simulado, sin IA real
MODE=local
# Los notebooks arrancan con el modelo simulado (1). Pon 0 para usar la ruta de MODE (IA real).
COURSE_OFFLINE=1

# MODE=local (docs/ollama.md)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct

# MODE=gemini: clave gratis en https://aistudio.google.com/apikey (docs/gemini.md)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# MODE=openrouter: clave gratis en https://openrouter.ai/keys y un ID que termine en :free
# (docs/openrouter.md)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
